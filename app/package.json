{
  "name": "Movimientos-del-Alma-page",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-local": "cp .local .env && vite --host",
    "start-dev": "cp .dev .env && vite --host",
    "start-prod": "cp .prod .env && vite --host",
    "start-local": "cp .local .env && vite --host",
    "build": "vite build && vite build --config vite.ssr.config.js && node scripts/prerender.mjs",
    "build-dev": "cp .dev .env && SITE_ENV=dev npm run build",
    "build-prod": "cp .prod .env && SITE_ENV=prod npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "npm run dev"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^9.11.1",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "vite": "^6.1.0"
  }
}
